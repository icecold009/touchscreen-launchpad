node_user -->|"uses"| node_ui
node_ui -->|"captures input"| node_input
node_input -->|"reports actions"| node_app
node_app -->|"applies modes"| node_performance
node_app -->|"controls playback"| node_audio
node_audio -->|"tracks voices"| node_voices
node_audio -->|"creates audio"| node_web_audio
node_app -->|"manages samples"| node_samples
node_app -->|"edits regions"| node_editor
node_app -->|"edits slices"| node_slices
node_app -->|"applies effects"| node_effects
node_app -->|"normalizes kits"| node_kits
node_app -->|"records changes"| node_history
node_app -->|"reads and writes"| node_db
node_app -->|"controls tempo"| node_transport
node_app -->|"runs patterns"| node_sequencer
node_app -->|"schedules events"| node_scheduler
node_sequencer -->|"emits steps"| node_app
node_app -->|"controls capture"| node_recording
node_app -->|"requests input"| node_microphone
node_recording -->|"creates take"| node_takes
node_app -->|"exports performance"| node_performance_export
node_performance_export -->|"encodes audio"| node_wav
node_app -->|"starts downloads"| node_downloads
node_app -.->|"configures MIDI"| node_midi
node_midi -.->|"reads and sends"| node_web_midi
node_service_worker -.->|"caches shell"| node_ui

